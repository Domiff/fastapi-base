APP_NAME=app
APP_TITLE=FastAPI Base
APP_VERSION=1

IS_DEBUG=true
APP_PORT=8080
LOG_LEVEL=INFO

BASE_URL=http://localhost:8080
CORS_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]


STRATEGY_SECRET_KEY=
RESET_SECRET_KEY=
VERIFICATION_SECRET_KEY=
LIFETIME_SECONDS=3600

# Ссылки из писем ведут во фронтенд, {base_url} и {token} подставляются
VERIFY_URL={base_url}/verify?token={token}
RESET_PASSWORD_URL={base_url}/reset-password?token={token}

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CONNECTION_POOL_MAXSIZE=10
EXPIRE=3600

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
TASKIQ_RETRY_COUNT=3
TASKIQ_RETRY_DELAY=5

# Endpoint — без протокола
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_DEFAULT_ACL=public-read
AWS_S3_USE_SSL=True

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
USE_CREDENTIALS=false
VALIDATE_CERTS=true

MP_SMTP_AUTH_ACCEPT_ANY=1
MP_SMTP_AUTH_ALLOW_INSECURE=1
